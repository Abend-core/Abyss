// Prisma schema — Abyss
// Source de vérité pour la base de données
// Schéma PostgreSQL: dbo

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["dbo"]
}

// ============================================================
// Model: User
// ============================================================
model User {
  id             String   @id @default(uuid()) @db.Uuid
  emailHash      String   @unique @map("email_hash") @db.VarChar(64)  // HMAC-SHA256 — blind index pour lookup
  emailEncrypted String   @map("email_encrypted") @db.Text              // AES-256-GCM — pour affichage
  passwordHash   String   @map("password_hash") @db.Text
  authSalt       String   @map("auth_salt") @db.VarChar(32)             // 16 bytes hex — pour hash password
  keySalt        String   @map("key_salt") @db.VarChar(32)              // 16 bytes hex — pour dérivation de clé
  keyFragment    String   @map("key_fragment") @db.VarChar(64)          // 32 bytes hex — split-key fragment
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  items          Item[]

  @@map("users")
  @@schema("dbo")
}

// ============================================================
// Model: Item
// ============================================================
model Item {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("items")
  @@schema("dbo")
}
